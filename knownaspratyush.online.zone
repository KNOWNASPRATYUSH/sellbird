$ORIGIN knownaspratyush.online.
$TTL 60

; ========================================================
; 1. Existing Vercel System Records (Your Live Website)
; ========================================================
@       IN  ALIAS   8ceaeb63910957f9.vercel-dns-017.com.
*       IN  ALIAS   cname.vercel-dns-017.com.
@       IN  CAA     0 issue "pki.goog"

; ========================================================
; 2. Titan Mail MX Records (Incoming Email & Verification)
; ========================================================
@       IN  MX  10  mx1.titan.email.
@       IN  MX  20  mx2.titan.email.

; ========================================================
; 3. Titan Mail SPF / TXT Record (Outbound Mail Authorization)
; ========================================================
@       IN  TXT     "v=spf1 include:spf.titan.email ~all"

; ========================================================
; 4. Titan Email Client Autodiscovery (Optional)
; ========================================================
imap    IN  CNAME   imap.titan.email.
smtp    IN  CNAME   smtp.titan.email.
